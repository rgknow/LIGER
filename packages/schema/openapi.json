              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Portfolio data"
          }
        }
      }
    },
    "/proposal": {
      "post": {
        "summary": "Create a new proposal",
        "requestBody": {
          "required": true,
