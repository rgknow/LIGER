            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Proposal created"
          }
        }
      }
    },
    "/proposal/{id}": {
      "get": {
        "summary": "Get proposal details",
        "parameters": [
          {
            "name": "id",
