datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =====================================
// CORE MODELS - Token Bank & SCS
// =====================================

model Student {
  id              String   @id @default(uuid())
  userId          String   @unique
  parentId        String
  scs             Float    @default(0)
  scsBreakdown    Json     // Agency, SEL, Financial, Digital, Mindset, Entrepreneurship
  walletBalance   Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  proposals       Proposal[]
  giftEvents      GiftEvent[]
  loanRequests    LoanRequest[]
  scholarshipApps ScholarshipApplication[]
  dossiers        Dossier[]
  walletTxns      WalletTransaction[]
  habitTasks      HabitTask[]
}

model WalletTransaction {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  type       String   // credit, debit, hold, release
  source     String   // gift, chore, proposal, loan, etc.
  amount     Float
  balance    Float
  metaJson   Json
  merkleHash String?
  anchoredTxid String?
  createdAt  DateTime @default(now())
}

// =====================================
// PROPOSAL & PARENT APPROVAL ENGINE
// =====================================

model Proposal {
  id              String   @id @default(uuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  vertical        String   // RE, stocks, commodities, etc.
  type            String   // investment, project, gift_use
  status          String   // draft, submitted, approved, rejected, revised, executed, anchored
  riskLevel       String   // Low, Medium, High
  scsSnapshot     Float
  briefJson       Json
  createdAt       DateTime @default(now())
  submittedAt     DateTime?
  parentDecisionAt DateTime?
  executedAt      DateTime?
  
  // Relations
  approvals       Approval[]
  audits          ProposalAudit[]
}

model Approval {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  parentId   String
  decision   String   // approve, reject, revise
  signature  String
  comment    String?
  requires2FA Boolean @default(false)
  createdAt  DateTime @default(now())
}

model ProposalTemplate {
  id      String @id @default(uuid())
  type    String @unique
  fields  Json
  version Int
}

model ProposalAudit {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  event      String
  actor      String
  metaJson   Json
  createdAt  DateTime @default(now())
}

// =====================================
// GIFT MANAGEMENT MODULE
// =====================================

model GiftEvent {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  name      String
  startAt   DateTime
  endAt     DateTime
  status    String   // active, completed, cancelled
  qrUri     String?
  progressCardJson Json
  createdAt DateTime @default(now())
  
  // Relations
  catalogItems GiftCatalogItem[]
  paymentIntents PaymentIntent[]
}

model GiftCatalogItem {
  id       String    @id @default(uuid())
  eventId  String
  event    GiftEvent @relation(fields: [eventId], references: [id])
  kind     String    // token_bundle, project_goal
  ctkAmount Float
  title    String
  description String?
  active   Boolean   @default(true)
  createdAt DateTime @default(now())
}

model PaymentIntent {
  id          String    @id @default(uuid())
  eventId     String
  event       GiftEvent @relation(fields: [eventId], references: [id])
  donorId     String?   // optional donor identity
  amountMinor Int       // amount in smallest currency unit
  currency    String
  status      String    // pending, completed, failed
  paymentMethod String  // upi, gpay, paypal, stripe
  qrUri       String?
  createdAt   DateTime  @default(now())
  
  // Relations
  giftCredits GiftCredit[]
}

model GiftCredit {
  id              String         @id @default(uuid())
  paymentIntentId String
  paymentIntent   PaymentIntent  @relation(fields: [paymentIntentId], references: [id])
  studentId       String
  ctkAmount       Float
  walletTxnId     String?
  createdAt       DateTime       @default(now())
}

// =====================================
// CHORES & PRODUCTIVITY ENGINE
// =====================================

model HabitTask {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  title      String
  schedule   String   // daily, weekly, custom
  status     String   // active, completed, paused
  streak     Int      @default(0)
  totalPoints Float   @default(0)
  createdBy  String   // parent user id
  createdAt  DateTime @default(now())
  
  // Relations
  validations HabitValidation[]
}

model HabitValidation {
  id          String    @id @default(uuid())
  taskId      String
  task        HabitTask @relation(fields: [taskId], references: [id])
  validatorId String    // parent user id
  status      String    // YES, PARTIAL, NO
  evidenceUri String?
  points      Float
  comment     String?
  createdAt   DateTime  @default(now())
}

// =====================================
// SCHOLARSHIPS & P2P LOANS MODULE
// =====================================

model Scholarship {
  id           String   @id @default(uuid())
  sponsorId    String
  title        String
  description  String?
  criteriaJson Json     // SCS threshold, domain requirements, etc.
  deadline     DateTime
  amountCtk    Float
  status       String   // active, awarded, expired
  createdAt    DateTime @default(now())
  
  // Relations
  applications ScholarshipApplication[]
}

model ScholarshipApplication {
  id            String      @id @default(uuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  scholarshipId String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id])
  dossierId     String?
  dossier       Dossier?    @relation(fields: [dossierId], references: [id])
  status        String      // pending, approved, rejected
  submittedAt   DateTime    @default(now())
  decidedAt     DateTime?
}

model LoanRequest {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  parentId      String
  briefJson     Json     // purpose, plan, etc.
  amountCtk     Float
  repaymentPlan String
  status        String   // draft, listed, funded, disbursed, repaying, completed, defaulted
  createdAt     DateTime @default(now())
  
  // Relations
  fundings      LoanFunding[]
  repayments    Repayment[]
}

model LoanFunding {
  id         String      @id @default(uuid())
  loanId     String
  loan       LoanRequest @relation(fields: [loanId], references: [id])
  investorId String
  amountCtk  Float
  sharePct   Float
  status     String      // committed, disbursed
  createdAt  DateTime    @default(now())
}

model Repayment {
  id            String      @id @default(uuid())
  loanId        String
  loan          LoanRequest @relation(fields: [loanId], references: [id])
  installmentNo Int
  dueDate       DateTime
  amountCtk     Float
  status        String      // pending, paid, overdue
  paidAt        DateTime?
}

// =====================================
// STUDENT DOSSIER SERVICE
// =====================================

model Dossier {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  snapshotJson Json     // SCS history, proposals, achievements, etc.
  hash         String   // SHA256 of the dossier content
  pdfUri       String?  // Link to generated PDF
  anchoredTxid String?  // Blockchain transaction ID
  createdAt    DateTime @default(now())
  
  // Relations
  scholarshipApps ScholarshipApplication[]
}

// =====================================
// BLOCKCHAIN ANCHORING
// =====================================

model BlockchainAnchor {
  id          String   @id @default(uuid())
  merkleRoot  String
  txid        String   // Polygon transaction ID
  blockHeight Int?
  dataHashes  String[] // Array of individual hashes included
  createdAt   DateTime @default(now())
}
