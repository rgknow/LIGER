# Environment variables for LIGER platform
DATABASE_URL="postgresql://postgres:password@localhost:5432/liger_dev?schema=public"

# JWT Secret for authentication
JWT_SECRET="your-jwt-secret-key-here"

# Blockchain configuration (Polygon Testnet)
POLYGON_RPC_URL="https://polygon-mumbai.infura.io/v3/your-infura-key"
POLYGON_PRIVATE_KEY="your-wallet-private-key"

# Firebase configuration for notifications
FIREBASE_PROJECT_ID="liger-platform"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@liger-platform.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Payment gateway configurations
STRIPE_SECRET_KEY="sk_test_..."
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"

# Email service (SendGrid)
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
FROM_EMAIL="notifications@ligerclub.com"

# SMS service (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Redis configuration for caching
REDIS_URL="redis://localhost:6379"

# NATS configuration for event bus
NATS_URL="nats://localhost:4222"